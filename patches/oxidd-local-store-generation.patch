+#[cfg(all(test, feature = "manager-index", not(feature = "manager-pointer")))]
+mod manager_lifetime_tests {
+    use super::{new_manager, BDDFunction};
+    use crate::{BooleanFunction, Manager, ManagerRef};
+
+    // On Linux, observe the GC thread belonging to each new manager. Checking
+    // its task ID after drop makes asynchronous retirement fail deterministically.
+    #[cfg(target_os = "linux")]
+    fn gc_threads() -> std::collections::HashSet<std::path::PathBuf> {
+        std::fs::read_dir("/proc/self/task")
+            .unwrap()
+            .map(|entry| entry.unwrap().path())
+            .filter(|task| {
+                std::fs::read_to_string(task.join("comm"))
+                    .map(|name| name.trim() == "oxidd mi gc")
+                    .unwrap_or(false)
+            })
+            .collect()
+    }
+
+    #[test]
+    fn repeated_manager_lifetimes_on_one_thread() {
+        for lifetime in 0..1_000 {
+            #[cfg(target_os = "linux")]
+            let previous_gc_threads = gc_threads();
+            let manager = new_manager(4096, 256, 1);
+            let (x, y, z) = manager.with_manager_exclusive(|m| {
+                m.add_named_vars(["x", "y", "z"]).unwrap();
+                (
+                    BDDFunction::var(m, 0).unwrap(),
+                    BDDFunction::var(m, 1).unwrap(),
+                    BDDFunction::var(m, 2).unwrap(),
+                )
+            });
+            for _ in 0..16 {
+                let f = x.and(&y).unwrap().or(&z).unwrap();
+                assert!(f.satisfiable(), "manager lifetime {lifetime}");
+            }
+            #[cfg(target_os = "linux")]
+            let mut new_gc_threads = Vec::new();
+            #[cfg(target_os = "linux")]
+            for _ in 0..1_000 {
+                new_gc_threads = gc_threads()
+                    .difference(&previous_gc_threads)
+                    .cloned()
+                    .collect();
+                if !new_gc_threads.is_empty() {
+                    break;
+                }
+                std::thread::yield_now();
+            }
+            #[cfg(target_os = "linux")]
+            assert_eq!(new_gc_threads.len(), 1, "manager lifetime {lifetime}");
+            drop((x, y, z));
+            drop(manager);
+            #[cfg(target_os = "linux")]
+            {
+                // /proc may briefly retain a task entry after pthread_join.
+                for _ in 0..1_000 {
+                    if !new_gc_threads[0].exists() {
+                        break;
+                    }
+                    std::thread::yield_now();
+                }
+                assert!(
+                    !new_gc_threads[0].exists(),
+                    "GC thread outlived manager lifetime {lifetime}"
+                );
+            }
+        }
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn concurrent_final_refs_retire_gc() {
+        for lifetime in 0..1_000 {
+            let before = gc_threads();
+            let manager = new_manager(1024, 128, 1);
+            let mut gc_task = None;
+            for _ in 0..1_000 {
+                gc_task = gc_threads().difference(&before).next().cloned();
+                if gc_task.is_some() {
+                    break;
+                }
+                std::thread::yield_now();
+            }
+            let gc_task = gc_task.expect("manager GC thread did not start");
+            let other = manager.clone();
+            let barrier = std::sync::Arc::new(std::sync::Barrier::new(3));
+            let first_barrier = barrier.clone();
+            let first = std::thread::spawn(move || {
+                first_barrier.wait();
+                drop(manager);
+            });
+            let second_barrier = barrier.clone();
+            let second = std::thread::spawn(move || {
+                second_barrier.wait();
+                drop(other);
+            });
+            barrier.wait();
+            first.join().unwrap();
+            second.join().unwrap();
+            for _ in 0..1_000 {
+                if !gc_task.exists() {
+                    break;
+                }
+                std::thread::yield_now();
+            }
+            assert!(!gc_task.exists(), "GC thread outlived lifetime {lifetime}");
+        }
+    }
+}
