# tlsf-tools meson options

option(
  'sanitize',
  type: 'combo',
  choices: ['none', 'address', 'undefined', 'address,undefined'],
  value: 'none',
  description: 'Enable sanitizers (for development builds)',
)

option(
  'oxidd',
  type: 'feature',
  value: 'disabled',
  description: 'Build OxiDD-backed research solver tools; use ' +
               '-Doxidd=enabled with -Dresearch_tools=true after building ' +
               'external/oxidd artifacts',
)

option('native_gr1', type: 'feature', value: 'disabled',
       description: 'Build the native GR(1) C API into libtlsf')
option('native_lift_oracle_root', type: 'string', value: '',
       description: 'Acacia source root for optional test-only Stage C differential')
option('native_lift_corpus_root', type: 'string', value: '',
       description: 'Optional parametric TLSF corpus root, up to eight serial cases')

option(
  'cpu',
  type: 'combo',
  choices: ['baseline', 'x86-64-v2', 'avx2', 'avx512', 'neon', 'native'],
  value: 'baseline',
  description: 'Target CPU ISA for the compile-time SIMD kernels (src/lib/' +
               'simd.h) and compiler auto-vectorization. baseline = ' +
               'portable scalar; x86-64-v2/avx2/avx512 = x86 SIMD; neon = ' +
               'AArch64 NEON; native = -march=native for this machine.',
)

option(
  'research_tools',
  type: 'boolean',
  value: false,
  description: 'Build decomposition, solver, bench, and template research CLIs',
)
option('issue24_corpus', type: 'string', value: '',
       description: 'Offline directory containing the five pinned issue-24 AAG files; enables serial corpus suites')
option('native_reduction_corpus', type: 'string', value: '',
       description: 'Optional TLSF corpus directory for native GR(1) differential tests')
