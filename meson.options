# tlsf-tools meson options

option('tests', type: 'boolean', value: true,
       description: 'Build and register tests (requires tools=true)')
option('tools', type: 'boolean', value: true,
       description: 'Build command-line tools, including enabled research tools')
option('examples', type: 'boolean', value: true,
       description: 'Build examples')

option('fuzz', type: 'boolean', value: false,
       description: 'Build libFuzzer targets with Clang, ASan and UBSan')

option(
  'sanitize',
  type: 'combo',
  choices: ['none', 'address', 'undefined', 'address,undefined'],
  value: 'none',
  description: 'Enable sanitizers (for development builds)',
)

option(
  'cpu',
  type: 'combo',
  choices: ['baseline', 'x86-64-v2', 'avx2', 'avx512', 'neon', 'native'],
  value: 'baseline',
  description: 'Target CPU ISA for compiler auto-vectorization, including the ' +
               'portable word-array kernels. baseline = compiler default; x86-64-v2/avx2/avx512 = x86 SIMD; neon = ' +
               'AArch64 NEON; native = -march=native for this machine.',
)

option(
  'research_tools',
  type: 'boolean',
  value: false,
  description: 'Build decomposition, solver, bench, and template research CLIs',
)
option('issue24_corpus', type: 'string', value: '',
       description: 'Offline directory containing the five pinned issue-24 AAG files; enables serial corpus suites')
