INFO {
  TITLE: "cluster_prune"
  DESCRIPTION: "satisfiable liveness assumption G F !r is retained in the g cluster and pruned from the disjoint h cluster"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { r; }
  OUTPUTS { g; h; }
  ASSUME {
    G F (!r);
  }
  GUARANTEE {
    G (r -> X g);
    G F h;
  }
}
