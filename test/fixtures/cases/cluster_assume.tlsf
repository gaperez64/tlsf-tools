INFO {
  TITLE: "cluster_assume"
  DESCRIPTION: "satisfiable pure-input assumption retained in the x cluster and pruned from the disjoint y cluster"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; b; }
  OUTPUTS { x; y; }
  ASSUME { G a; }
  GUARANTEE {
    G (x <-> X a);
    G (y <-> X b);
  }
}
