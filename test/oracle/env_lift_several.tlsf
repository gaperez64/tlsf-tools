INFO {
  TITLE: "several independent fairness assumptions"
  DESCRIPTION: "three fairness obligations and a simple losing system goal"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL { PARAMETERS { width = 6; } }
MAIN {
  INPUTS { req0; req1; req2; }
  OUTPUTS { grant[0..width-1]; }
  ASSUME { G F req0; G F req1; G F req2; }
  GUARANTEE {
    G F grant[0];
    &&[0 <= i < width] G (!grant[i]);
  }
}
