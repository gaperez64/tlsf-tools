{
  "tools": [
    "ltlsynt",
    "ltlfsynt",
    "autfilt",
    "ltl2tgba",
    "ltlfilt",
    "randltl"
  ],
  "modules": [
    "spot",
    "buddy",
    "acacia_lift"
  ],
  "forbidden_pattern": "(?i)(?<![a-z0-9_])(?:spot|buddy|acacia_lift|libspot|autfilt|ltl2tgba|ltlfilt|ltlfsynt|ltlsynt|randltl)(?![a-z0-9_])|--spot(?:-source)?\\b|--bindings-site\\b|spot::|\\bspot_[a-z_]+|-lspot\\b",
  "text_mutants": [
    {
      "suffix": ".cc",
      "source": "#include <spot/tl/parse.hh>"
    },
    {
      "suffix": ".py",
      "source": "import spot"
    },
    {
      "suffix": ".sh",
      "source": "pkg-config --libs libspot"
    },
    {
      "suffix": ".sh",
      "source": "\"$prefix/bin/ltlsynt\" -f true"
    },
    {
      "suffix": ".py",
      "source": "from importlib import import_module\nimport_module(\"spot\")"
    },
    {
      "suffix": ".py",
      "source": "# spot"
    },
    {
      "suffix": ".json",
      "source": "{\"command\": \"ltlsynt\"}"
    }
  ],
  "python_mutants": [
    {
